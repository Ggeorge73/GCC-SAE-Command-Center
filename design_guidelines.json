  "universal_guidelines": [
    "Use 'Playfair Display' for all Section Headings and 'Manrope' for body text.",
    "The UI must be strictly DARK MODE. No white backgrounds. Use #0a1628 for main bg.",
    "Use Gold (#c9a227) sparingly for high-value actions (buttons, active states).",
    "Borders should be very subtle (opacity 0.2) or glowy for active states.",
    "Do not use rounded corners larger than 'rounded-md'. Keep it professional and sharp.",
    "Always add 'data-testid' to interactive elements.",
    "Use 'sonner' for toast notifications.",
    "For the Document Vault, use a grid layout with card previews.",
    "Chat interface should feel like a high-end encrypted messaging app (e.g., Signal meets Bloomberg Terminal).",
    "Sidebar must look like a legal case file list - structured and dense."
  ]
}
