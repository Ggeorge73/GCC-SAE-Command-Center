REACT_APP_BACKEND_URL=http://localhost:8001

# Firebase configuration values are public client identifiers, but storage access
# must still be protected by authenticated Firebase Security Rules.
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=

# Optional Emergent development instrumentation. Leave disabled for normal
# local development and CI because it is not required by the product.
ENABLE_VISUAL_EDITS=false
