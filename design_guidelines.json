{
  "design_system": {
    "brand_identity": {
      "name": "Law Suite",
      "full_name": "Enterprise Legal Advisory Workspace",
      "ethos": "Elite, Authoritative, Secure, Precision",
      "archetype": "The Old Money Tech",
      "theme_mode": "dark"
    },
    "typography": {
      "font_family": {
        "headings": "Playfair Display, serif",
        "body": "Manrope, sans-serif",
        "mono": "JetBrains Mono, monospace"
      },
      "scale": {
        "h1": "text-4xl md:text-5xl font-bold tracking-tight",
        "h2": "text-3xl font-semibold tracking-tight",
        "h3": "text-2xl font-medium",
        "body_lg": "text-lg leading-relaxed",
        "body_base": "text-base leading-relaxed",
        "caption": "text-sm text-muted-foreground",
        "label": "text-xs font-bold uppercase tracking-widest text-primary/80"
      },
      "installation": {
        "google_fonts": "https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Manrope:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap"
      }
    },
    "colors": {
      "palette": {
        "primary": {
          "DEFAULT": "#c9a227",
          "foreground": "#0a1628",
          "hover": "#d4b036",
          "active": "#b89320"
        },
        "background": {
          "DEFAULT": "#0a1628",
          "secondary": "#0f1f38",
          "tertiary": "#152a4a"
        },
        "foreground": {
          "DEFAULT": "#e2e8f0",
          "muted": "#94a3b8"
        },
        "accent": {
          "gold": "#c9a227",
          "gold_dim": "rgba(201, 162, 39, 0.15)",
          "navy_light": "#1e3a66"
        },
        "status": {
          "success": "#10b981",
          "warning": "#f59e0b",
          "error": "#ef4444",
          "info": "#3b82f6"
        },
        "border": {
          "DEFAULT": "rgba(201, 162, 39, 0.2)",
          "strong": "rgba(201, 162, 39, 0.4)"
        }
      },
      "gradients": {
        "gold_glow": "radial-gradient(circle at center, rgba(201, 162, 39, 0.15) 0%, transparent 70%)",
        "navy_depth": "linear-gradient(180deg, rgba(10, 22, 40, 0) 0%, rgba(10, 22, 40, 0.8) 100%)"
      }
    },
    "spacing": {
      "container_padding": "p-6 md:p-8 lg:p-12",
      "section_gap": "gap-8",
      "component_gap": "gap-4"
    },
    "visual_enhancers": {
      "radius": {
        "default": "rounded-sm",
        "card": "rounded-md",
        "button": "rounded-none"
      },
      "shadows": {
        "card": "0 4px 20px -2px rgba(0, 0, 0, 0.5)",
        "glow": "0 0 15px rgba(201, 162, 39, 0.15)"
      },
      "borders": {
        "style": "border border-border",
        "active": "border-primary/50 ring-1 ring-primary/20"
      },
      "glassmorphism": {
        "header": "bg-[#0a1628]/80 backdrop-blur-md border-b border-white/5",
        "panel": "bg-[#0f1f38]/60 backdrop-blur-xl border border-white/5"
      }
    },
    "layout_structure": {
      "dashboard_grid": {
        "wrapper": "grid h-screen w-full pl-[56px] md:pl-[240px]",
        "sidebar": "fixed left-0 top-0 h-full w-[240px] border-r border-[#1e3a66] bg-[#0a1628] hidden md:flex flex-col z-30",
        "main_area": "flex flex-col flex-1 h-full overflow-hidden bg-[#0a1628]",
        "three_pane": "grid grid-cols-1 lg:grid-cols-12 h-full",
        "chat_pane": "lg:col-span-8 flex flex-col h-full relative",
        "vault_pane": "lg:col-span-4 border-l border-[#1e3a66] bg-[#0f1f38]/50 h-full overflow-y-auto hidden lg:block"
      }
    }
  },
  "components": {
    "buttons": {
      "primary": "bg-primary text-primary-foreground hover:bg-primary/90 rounded-sm font-serif font-medium px-6 py-2 transition-all duration-300",
      "secondary": "bg-transparent border border-primary/30 text-primary hover:bg-primary/10 rounded-sm px-6 py-2 font-serif",
      "ghost": "hover:bg-accent hover:text-white text-muted-foreground transition-colors"
    },
    "cards": {
      "base": "bg-[#0f1f38] border border-[#1e3a66] rounded-sm p-6 shadow-xl relative overflow-hidden group",
      "deal_room": "hover:border-primary/40 transition-all duration-300 bg-gradient-to-br from-[#0f1f38] to-[#0a1628]"
    },
    "inputs": {
      "base": "bg-[#0a1628] border-primary/20 focus:border-primary/60 focus:ring-1 focus:ring-primary/20 text-foreground placeholder:text-muted-foreground/50 rounded-sm h-12 font-sans"
    },
    "badges": {
      "compliance_success": "bg-green-900/30 text-green-400 border border-green-800/50 px-2 py-0.5 text-[10px] uppercase tracking-wider font-bold",
      "compliance_warning": "bg-yellow-900/30 text-yellow-400 border border-yellow-800/50 px-2 py-0.5 text-[10px] uppercase tracking-wider font-bold",
      "compliance_error": "bg-red-900/30 text-red-400 border border-red-800/50 px-2 py-0.5 text-[10px] uppercase tracking-wider font-bold"
    }
  },
